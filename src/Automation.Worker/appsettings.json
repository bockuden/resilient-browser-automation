{
  "Automation": {
    "Browser": {
      "Headless": true,
      "NavigationTimeoutSeconds": 30,
      "OperationTimeoutSeconds": 30,
      "DemoUsername": "demo",
      "DemoPassword": "automation"
    },
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelayMilliseconds": 250,
      "MaxDelayMilliseconds": 5000
    },
    "Timeouts": {
      "WholeJobTimeoutSeconds": 300
    },
    "Concurrency": {
      "MaxConcurrentJobs": 1,
      "QueueCapacity": 32,
      "PerTargetRateLimit": 1,
      "PerTargetRatePeriodMilliseconds": 1000,
      "PerTargetBurstSize": 1,
      "ShutdownGracePeriodSeconds": 30
    },
    "Storage": {
      "ConnectionString": "Data Source=artifacts/automation.db",
      "StaleRunningJobSeconds": 300
    },
    "Artifacts": {
      "RootPath": "artifacts",
      "RetentionDays": 14,
      "MaximumTotalSizeMegabytes": 512
    }
  }
}
